{
  "schema": 1,
  "id": "nvidia-shield-tv-2015",
  "name": "NVIDIA SHIELD Android TV 2015",
  "tested": {
    "os": "Android TV 2015",
    "sdk": 30,
    "build": null
  },
  "launcher": null,
  "keep": [],
  "groups": [
    {
      "title": "Batch 1: NVIDIA and Google telemetry and feedback",
      "packages": [
        {
          "pkg": "com.nvidia.stats",
          "note": "anonymous usage statistics"
        },
        {
          "pkg": "com.nvidia.feedback",
          "note": "crash reports and the \"send feedback\" form"
        },
        {
          "pkg": "com.google.android.feedback"
        }
      ]
    },
    {
      "title": "Batch 2: sponsored rows, promos, auto-installs, gaming leftovers",
      "packages": [
        {
          "pkg": "android.autoinstalls.config.nvidia",
          "note": "Play auto-installs of partner apps"
        },
        {
          "pkg": "com.nvidia.shield.welcome",
          "note": "first-run promo"
        },
        {
          "pkg": "com.nvidia.factorybundling",
          "note": "accessory bundle offers"
        },
        {
          "pkg": "com.nvidia.shield.beta",
          "note": "beta programme"
        },
        {
          "pkg": "com.nvidia.shieldbeta",
          "note": "beta programme"
        },
        {
          "pkg": "com.nvidia.shield.registration",
          "note": "product registration"
        },
        {
          "pkg": "com.nvidia.tegrazone3",
          "note": "\"NVIDIA Games\" app and row"
        }
      ]
    },
    {
      "title": "Batch 3: factory and developer test tools (disabled, never launched)",
      "packages": [
        {
          "pkg": "com.nvidia.factorysyschecker"
        },
        {
          "pkg": "com.nvidia.inputviewer"
        }
      ]
    },
    {
      "title": "Batch 4: idle background services",
      "packages": [
        {
          "pkg": "com.android.printspooler"
        },
        {
          "pkg": "com.android.dynsystem",
          "note": "Dynamic System Updates (GSI loader)"
        },
        {
          "pkg": "com.android.cts.ctsshim",
          "note": "CTS test shim"
        },
        {
          "pkg": "com.android.cts.priv.ctsshim",
          "note": "CTS test shim"
        },
        {
          "pkg": "com.google.android.onetimeinitializer",
          "note": "runs once at first boot"
        }
      ]
    },
    {
      "title": "Batch 5: apps the owner doesn't use",
      "packages": [
        {
          "pkg": "com.google.android.play.games"
        }
      ]
    },
    {
      "title": "Stock Android TV launcher: disabling it is what hands Home to the replacement launcher",
      "packages": [
        {
          "pkg": "com.google.android.tvlauncher"
        }
      ]
    }
  ],
  "source": {
    "repo": "Gathin23/cleanyourtv",
    "path": "examples/nvidia-shield-tv-2015/debloat.txt",
    "commit": "be6087056a1c7d4f08f3f1cc778d92374d86ef27"
  }
}
